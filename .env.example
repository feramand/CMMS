# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL (desarrollo local; con Docker la arma docker-compose)
DATABASE_URL=postgres://cmms:cmms@localhost:5432/cmms

# Contraseña de la base de datos cuando se instala con Docker
POSTGRES_PASSWORD=

# Clave para firmar las sesiones: al menos 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
SESSION_SECRET=

# Solo para pruebas locales sin HTTPS con la versión de producción. No usar en la planta.
# COOKIE_SIN_HTTPS=1

# Notificaciones push al celular (opcional). Generar el par de claves con:
#   npx web-push generate-vapid-keys
# Sin estas claves la aplicación funciona igual, pero los avisos solo se ven al abrirla.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del administrador del sistema, con el formato mailto:correo@empresa.cl
VAPID_SUBJECT=

# Primer administrador (solo se usa al ejecutar "npm run db:seed")
ADMIN_RUT=
ADMIN_NOMBRE=
ADMIN_CLAVE=
